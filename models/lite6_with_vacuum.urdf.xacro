<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="lite6_robot">

  <xacro:property name="use_xacro_load_yaml" value="true" />

  <xacro:property name="mesh_path" value="meshes" />
  <xacro:property name="mesh_suffix" value="stl" />

  <xacro:include filename="common.link.xacro" />

  <xacro:include filename="lite6.urdf.xacro" />
  <xacro:include filename="lite_vacuum_gripper.urdf.xacro" />

  <xacro:lite6_urdf 
    prefix="" 
    kinematics_params_filename="lite6_default_kinematics.yaml"
    inertial_params_filename="xarm6_type9_HT_BR2" />

  <xacro:uflite_gripper_urdf 
    prefix="" 
    attach_to="link6" 
    attach_xyz="0 0 0" 
    attach_rpy="0 0 0" />

</robot>